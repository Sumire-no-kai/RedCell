# ─────────────────────────────────────────────────────────────
# RedCell .gitignore
# ─────────────────────────────────────────────────────────────

# ── Internal / private docs (do NOT publish) ────────────────
# 产品需求与 AI 代理协作规范属于内部文档,仅本地保留,不推送远端。
PRD.md
AGENTS.md
CLAUDE.md
/docs/internal/
*.private.md
NOTES.md

# ── Secrets & environment ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
**/credentials.json

# ── Node / Next.js / frontend ───────────────────────────────
node_modules/
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Python / control-plane ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── Supabase ────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ── RedCell runtime artifacts (traces / runs / findings) ────
# 攻击轨迹与运行产物可能含敏感 / 靶场数据,默认本地保留。
/data/
/runs/
/traces/
*.trace.json
*.findings.json
*.run.json

# ── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE / editor / OS ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code local ───────────────────────────────────────
.claude/settings.local.json

# ── Logs / temp ─────────────────────────────────────────────
*.log
logs/
tmp/
.cache/
