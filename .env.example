# RedCell 环境配置模板
#
# 用法:`cp .env.example .env`,然后在 .env 里填真实值。
# .env 已被 .gitignore 覆盖,永远不进版本库;本文件(.env.example)是公开的,
# 所以**这里永远只放变量名和说明,不放任何真实值**。
#
# ⚠️ 当前状态:CLI 还没有读这些变量(接线是下一步)。
#    `OpenAICompatibleProvider` 已就绪,scratchpad 里的 preflight 脚本已在用本文件。

# ── 为什么 target 与 attacker 完全分开配置 ──────────────────────────────
# 见 CONCEPTS.md §14.4。两者可以是同一家、同一个模型,但必须分别记录 ——
# 否则换 target 时可能顺带换掉 attacker,成功率一变就无法归因是
# 被测对象变了、攻击者变强了,还是算法真的更好。
#
# 当前选型(2026-08-01 决定):
#   target   = 智谱 GLM-4.7-Flash(永久免费,承担约 80% 的调用量)
#   attacker = Gemini 免费层(调用量小,但话术质量直接决定策略分化能否测出来)

# ── 目标模型:被测的那一个 ────────────────────────────────────────────
REDCELL_TARGET_PROVIDER=glm
REDCELL_TARGET_BASE_URL=https://open.bigmodel.cn/api/paas/v4
REDCELL_TARGET_API_KEY=

# ⚠️ 必须填具体版本串,不要用滚动别名。厂商中途更新模型不会报任何错,
#    只会让此前的实验结论静默作废 —— 你只看得到"数字对不上",查不出原因。
#    GLM-4.7-Flash 目前**没有**带日期的版本变体,所以退而求其次:
#    provider 会把服务端回传的 model 串写进 trace,让漂移至少**可检测**。
REDCELL_TARGET_MODEL=glm-4.7-flash

# ⚠️ 校准期不能设 0,见 CALIBRATION.md §3。
#    temperature=0 会让复现率退化成 0% 或 100% 的布尔值,而复现率是 PRD 核心指标。
#    (注:Claude 5 系列已移除 temperature,传值会 400。GLM / Gemini 均正常支持。)
REDCELL_TARGET_TEMPERATURE=0.7

# 每分钟最多几次请求。0 = 不节流。
# GLM 免费档实测限流以账户面板为准;官方文档只说"不同模型不同并发上限"。
REDCELL_TARGET_RPM=0

# ── 攻击模型:生成攻击话术的那一个 ────────────────────────────────────
REDCELL_ATTACKER_PROVIDER=gemini
# Gemini 的 OpenAI 兼容端点,可复用同一个 Provider 实现。
REDCELL_ATTACKER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
REDCELL_ATTACKER_API_KEY=
REDCELL_ATTACKER_MODEL=

# 留空待定。取值有个未记录的取舍:调高鼓励话术变体,但除非厂商提供 seed 参数,
# 否则"同一 seed → 同一次攻击"的可复现性保证会失效(降级为"同分布可比")。
REDCELL_ATTACKER_TEMPERATURE=

# ⚠️ Gemini 免费层约 10 RPM —— 不自律就会被 429 打穿。10 RPM 填 10。
REDCELL_ATTACKER_RPM=10
