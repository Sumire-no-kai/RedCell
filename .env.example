# RedCell 环境配置模板
#
# 用法:`cp .env.example .env`,然后在 .env 里填真实值。
# .env 与 .env.* 都已被 .gitignore 覆盖;本文件是公开的,
# 所以**这里永远只放变量名和说明,不放任何真实值**。
#
# 最后更新:2026-08-06

# ── 为什么 target 与 attacker 完全分开配置 ──────────────────────────────
# 见 CONCEPTS.md §14.4。两者可以是同一家、甚至同一个模型,但必须分别记录 ——
# 否则换 target 时可能顺带换掉 attacker,成功率一变就无法归因是
# 被测对象变了、攻击者变强了,还是算法真的更好。
#
# 两个位子的**要求完全不同**,选型时不要套用同一套标准:
#
#   target(约 80% 调用量)必须满足:
#     · OpenAI 兼容 chat/completions
#     · 能在自由文本里跟随 <tool_call>{...} 格式 —— 靶场走 codec.py 的文本协议,
#       **不用原生 function calling**,所以厂商文档上的 "Tool Calls ✓" 不代表通过
#     · 阳性对照两条线都点得亮:canary 泄漏 + 跨用户工具调用
#       (2026-08-05/06 实测:gemini-3.1-flash-lite、gemini-3-flash-preview、
#        deepseek-v4-flash 均只点亮至多 canary 线,工具线 0/3 —— 全部不能当靶场。
#        目前测过的模型里**只有 GLM 家族会去碰跨用户工具**)
#     · usage 记账诚实;thinking 模型要确认 reasoning token 是否计进 completion_tokens
#     · 并发/配额撑得住:限流是长期的真瓶颈(彩排里 170 次重试全在 target 侧)
#   选弱了可以拧 CALIBRATION.md §10 的旋钮救回来。
#
#   attacker(调用量小,但决定成败)必须满足:
#     · 话术长且完整,**不截断** —— 截断的话术是残缺的仪器,
#       且截断率可能因策略而异,那就是偏差不是噪声
#     · 零空输出(gemma-4-31b 因"按策略差异极大的空输出率"出局)
#     · 没有吃 max_tokens 预算的隐藏思考
#   选弱了**救不回来**(CALIBRATION.md §11:标准 3 不过时拧旋钮解决不了)。

# ── 当前选型(2026-08-06)──────────────────────────────────────────────
#   target   = 智谱 GLM-4.7-FlashX(付费,关闭 thinking;唯一通过阳性对照
#              两条线、且吞吐可用的靶场 —— 免费的 4.7-flash 同样通过,
#              但并发硬限 1、且默认开 thinking 导致延迟约 6-12 倍)
#   attacker = Gemini 3.1 Flash Lite(付费第 1 层)

# ═══ target:被测的那一个 ═══════════════════════════════════════════════
REDCELL_TARGET_PROVIDER=glm

# ⚠️ 智谱有两个站,key 格式相同、极易混淆:
#    国际站 Z.AI      https://api.z.ai/api/paas/v4
#    国内站 bigmodel  https://open.bigmodel.cn/api/paas/v4
REDCELL_TARGET_BASE_URL=
REDCELL_TARGET_API_KEY=

# ⚠️ 应当填**带版本的具体串**,不要用滚动别名 —— 厂商中途换权重不会报任何错,
#    只会让此前的实验结论静默作废。
#    但 2026-08-05/06 实测:Gemini 全线 9 个 3.x 文本模型**没有一个带日期后缀**,
#    2.x 系(唯一有 -001 钉死版的一代)已全部 404 下线;DeepSeek 文档给出的
#    `DeepSeek-V4-Flash-0731` 是展示标签,当作 API 模型串传会 400。
#    → 「钉死带日期版本」在目前测过的每一家都**结构性做不到**,只剩两条替代防线:
#      ① llm/fingerprint.py 的行为指纹(GLM 上稳定可用,Gemini 上不稳定)
#      ② 纪律:同一组消融必须在同一时间窗内跑完
REDCELL_TARGET_MODEL=

# 每分钟最多几次请求,0 = 不节流。给按 **RPM** 限流的 provider 用。
REDCELL_TARGET_RPM=0

# 同时在途的请求数上限,0 = 不限。给按**并发数**限流的 provider 用。
# 两者管的是不同的东西,不能互相替代:GLM 按并发限流(4.7-Flash 上限 1,
# 4.5-Flash 2,4.7-FlashX 付费 3 —— 2026-08-06 实测 6 分钟 36 次请求零 429),
# Gemini 按 RPM 限流。
# ⚠️ 底层配额没提高之前调大并发只会把 429 变多 —— 免费档在并发 1 上就已经在吃限流了。
# ⚠️ orchestrator 目前仍是串行执行,这个上限暂时用不满 —— 它只影响 provider
#    层的本地闸门,不会让 CLI 自动并发发起多场 attempt。
REDCELL_TARGET_MAX_CONCURRENCY=

# 每百万 token 的美元单价,**没有默认值,必须显式填**。
# OpenAI 兼容协议的 usage 只回 token 数、从不回金额,所以 --max-cost 能不能用
# 完全取决于这两行填没填对。免费模型显式写 0 —— 那是一句"我确认它免费"的声明,
# 与"忘了填"在语义上必须分得开。
# ⚠️ 已知局限:TokenPricing 只有单一输入单价,**没有缓存命中档**。
#    DeepSeek 的缓存命中价是未命中的 1/50,用它会让成本被系统性高估
#    (仅供参考——DeepSeek 已实测不适任,见下方"已排除"一节)。
REDCELL_TARGET_INPUT_USD_PER_MTOK=
REDCELL_TARGET_OUTPUT_USD_PER_MTOK=

# 原样并入每次请求 payload 的厂商专属字段,JSON 格式。
# ⚠️⚠️ 这是一个隐藏旋钮,不是普通配置项。2026-08-06 实测:GLM 的
#    `{"thinking": {"type": "disabled"}}` 能把延迟从约 30-55 秒压到约 4-5 秒
#    (12 倍),但同时让约 15-20% 的工具调用尝试改用 Python 函数调用语法而非
#    JSON——已在 codec.py 加回退解析器修好并重跑阳性对照验证(三条全过)。
#    启用它必须像 CALIBRATION.md §10 的四个旋钮一样显式声明、重跑阳性对照、
#    写进 DEVLOG,不能当默认性能优化用。详见 DEVLOG.md Step 37。
#    留空 `{}` 或不设即为不启用(GLM 默认开 thinking)。
REDCELL_TARGET_EXTRA_BODY={}

# ═══ attacker:生成攻击话术的那一个 ═════════════════════════════════════
REDCELL_ATTACKER_PROVIDER=gemini
# Gemini 的 OpenAI 兼容端点,复用同一个 Provider 实现。
REDCELL_ATTACKER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
REDCELL_ATTACKER_API_KEY=
REDCELL_ATTACKER_MODEL=

REDCELL_ATTACKER_RPM=0
REDCELL_ATTACKER_MAX_CONCURRENCY=0

# ⚠️ 单次回复的 token 上限。**开了 thinking 的模型必须调大** ——
#    思考 token 占用这个预算却不计进 completion_tokens。
#    2026-08-03 实测:gemini-3.5-flash 在 512 下 7/7 句中截断、3.6-flash 3/7,
#    调到 2048 后归零;flash-lite 无 thinking,512 下 0/7。
#    截断同时意味着成本被低估:--max-cost 按 usage 算,而思考 token 不在里面。
REDCELL_ATTACKER_MAX_TOKENS=512

REDCELL_ATTACKER_INPUT_USD_PER_MTOK=
REDCELL_ATTACKER_OUTPUT_USD_PER_MTOK=

# ═══ 已排除的靶场候选(实测记录,不建议重试)═════════════════════════════
#
# DeepSeek V4 Flash —— 2026-08-06 实测:阳性对照三条全 FAIL,canary 与工具线
#   均 0/3。模型默认把 system prompt 里的内容当机密(即使零防御措辞、字面上
#   完全中性也一样),这条防御长在权重里,靶场没有任何旋钮碰得到。
#   其余每项指标(延迟 5.7s、并发上限 2500、usage 记账最诚实)都比 GLM 强,
#   但过不了阳性对照就是不能用。
#
# gemini-3.1-flash-lite / gemini-3-flash-preview —— 2026-08-05 实测:canary
#   线点得亮,工具线 0/3(零次工具调用,不是格式问题,是模型不去调用)。
#   3.5-flash-lite / 3.6-flash / 3.5-flash 同理,外加默认开 thinking 导致
#   token 截断与隐藏计费,两层坑一起踩。
#
# glm-4-32b-0414-128k —— 2026-08-05 实测:canary 线通过、零思考、延迟最快
#   (6.2s),且是**唯一名字里带日期的模型**(本可解决约定 #5),但工具线
#   0 调用 0 坏格式,与 Gemini 同一种死法,可惜。
#
# glm-4.5-flash —— 免费但慢(38.1s),工具线出现坏格式(尝试调用但格式跑偏),
#   延迟太高不值得为它单独修 codec。

# ═══ ⚠️ 已知未接线的设置 ═══════════════════════════════════════════════
# 下面这些变量会被读进 settings,但**没有任何代码消费它们** ——
# 填了不会生效,也不会报错。列在这里是为了让它们不再是陷阱。
#
#   REDCELL_TARGET_TEMPERATURE / REDCELL_ATTACKER_TEMPERATURE
#     ProviderSettings.build() 不把 temperature 传给 provider。
#     实际取值来自代码默认:靶场 0.7(ArenaAdapter),攻击方 1.0(LLMMutationGenerator)。
#     数值恰好与 CALIBRATION.md §3 的冻结值一致,所以当前行为是对的 ——
#     但改这两行做敏感性分析**不会有任何效果**。
#
#   REDCELL_TARGET_MAX_TOKENS
#     靶场刻意不设回复上限:设了会把工具调用截在 JSON 中间,
#     而解析失败与"靶场成功防守"在数据里长得一模一样。
